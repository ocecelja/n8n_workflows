          "cachedResultName": "gpt-5"
        },
        "options": {}
      },
      "id": "a6377095-7643-4737-9a58-f8295b8e21f0",
      "name": "LLM GPT-5",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        304,
