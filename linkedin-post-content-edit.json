      "credentials": {
        "openAiApi": {
          "id": "XStdg09nSm0XQbuY",
          "name": "POE OpanAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Normalize upstream outputs\nconst contentOut = $input.first().json.output;\nconst hashtagOut = $('Load Draft').first().json.hashtags;\n\n// Build main post body\nconst postContentBase =\n  contentOut.topic + `\\n\\n` +\n  contentOut.what_happened + `\\n\\n` +\n  contentOut.why_it_happened + `\\n\\n` +\n  contentOut.solution_and_takeaway;\n\n// Final post content\nconst postContent = postContentBase;\n\nreturn [{\n  json: {\n    ...$json,\n    \"post title\": contentOut.topic,\n    \"post content\": postContent\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
