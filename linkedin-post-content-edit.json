    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"topic\": \"1 punchy sentence; no cause, no solution.\",\n  \"what_happened\": \"describe the real-world symptom + context; no root cause, no fixes.\",\n  \"why_it_happened\": \"technical root cause; no fixes.\",\n  \"solution_and_takeaway\": \"fixes + prevention + final takeaway; do not introduce new symptoms.\",\n  \"image_description\": \"describe an image\"\n}"
      },
      "id": "c2f42701-9fc2-4918-b558-93ddeb41dbf9",
      "name": "Structured Output Parser1",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        352,
        224
      ],
      "typeVersion": 1.2
    },
    {
      "parameters": {
        "jsCode": "// Normalize upstream outputs\nconst contentOut = $input.first().json.output;\nconst hashtagOut = $('Get row(s)').first().json.hashtags;\n\n// Build main post body\nconst postContentBase =\n  contentOut.topic + `\\n\\n` +\n  contentOut.what_happened + `\\n\\n` +\n  contentOut.why_it_happened + `\\n\\n` +\n  contentOut.solution_and_takeaway;\n\n// Final post content\nconst postContent = postContentBase;\n\nreturn [{\n  json: {\n    ...$json,\n    \"post title\": contentOut.topic,\n    \"post content\": postContent\n  }\n}];\n"
      },
