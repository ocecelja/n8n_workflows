        "id": "b2b9b3d3-afcf-4c48-b08c-b3aeef7eb1d9",
        "name": "Normalize LLM Out",
        "alwaysOutputData": true
      },
      {
        "parameters": {
          "jsCode": "// n8n Code node (JavaScript)\n// Goal: always output { image_prompt: [<string>] }.\n// Handles cases where input.output is either an object {image_prompt: \"...\"} or a plain string.\n// Also strips markdown and optionally extracts a direct URL if present.\n\nconst trigger = $items('Inbound Image Req')[0]?.json ?? {};\nconst item = $input.first().json;\nconst out = item.output;\n\n// 1) Normalize to a string prompt\nlet promptText = \"\";\n\nif (out && typeof out === \"object\") {\n  // Old schema: { image_prompt: \"...\" }\n  promptText = out.image_prompt ?? \"\";\n} else if (typeof out === \"string\") {\n  // New schema: plain text\n  promptText = out;\n} else {\n  promptText = \"\";\n}\n\n// 2) If the model returned markdown with an image + URL, extract the best URL\n// Prefer the last http(s) URL in the text (often the direct link).\nconst urlMatches = promptText.match(/https?:\\/\\/\\S+/g) || [];\nconst bestUrl = urlMatches.length ? urlMatches[urlMatches.length - 1].replace(/[\\)\\]\\s]+$/g, \"\") : \"\";\n\n// 3) Remove markdown image syntax to avoid feeding junk downstream (optional but recommended)\npromptText = promptText\n  .replace(/!\\[[^\\]]*\\]\\([^)]+\\)/g, \"\")   // remove markdown images\n  .replace(/\\n{3,}/g, \"\\n\\n\")            // collapse excessive newlines\n  .trim();\n\n// 4) Decide what downstream should receive:\n// - If your next node expects a prompt to generate an image, you want a CLEAN PROMPT (not a URL).\n// - If your next node expects an IMAGE URL, pass bestUrl instead.\n// Choose ONE of these outputs:\n\n// A) Use clean prompt text (recommended if next step is image generation):\nconst finalValue = promptText;\n\n// B) Use extracted URL (use this if next step downloads the image):\n// const finalValue = bestUrl;\n\nconst prompts = finalValue ? [finalValue] : [];\n\nreturn [\n  {\n    json: {\n      // carry IDs forward (string + trim is safest)\n      message_id: trigger.message_id != null ? String(trigger.message_id).trim() : null,\n      content_id: trigger.content_id != null ? String(trigger.content_id).trim() : null,\n\n      image_prompt: prompts,\n      extracted_image_url: bestUrl,\n    },\n  },\n];\n"
        },
