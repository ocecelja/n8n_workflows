        "jsCode": "const post = $('Fetch Draft').first().json.post_content ?? '';\nconst hashtags = $('Fetch Draft').first().json.hashtags ?? '';\n\n// Combine post + hashtags with double newline (only if hashtags exist)\nconst combinedText = hashtags\n  ? `${post}\\n\\n${hashtags}`\n  : post;\n\n// Escape LinkedIn \"little text format\" reserved characters\n// Includes: \\ | { } @ [ ] ( ) < > # * _ ~\nconst escaped = combinedText.replace(/[\\\\|{}@\\[\\]()<>\\#*_~]/g, (m) => `\\\\${m}`);\n\nreturn [{\n  json: {\n    ...$json,\n    commentary_escaped: escaped,\n  }\n}];\n"
